# /home/ubuntu/app/.env  (chmod 600) — systemd EnvironmentFile 로 주입됨
SPRING_PROFILES_ACTIVE=prod

DATABASE_URL=jdbc:postgresql://<rds-host>:5432/mappy_english
DATABASE_USERNAME=
DATABASE_PASSWORD=

# base64 인코딩된 256bit 이상 키
JWT_SECRET_KEY=
# sk-...
OPENAI_API_KEY=

KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=https://mappyenglish.com/auth/kakao/callback

# firebase-key.json 을 base64 한 줄로: base64 -w0 firebase-key.json
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_STORAGE_BUCKET=mappyproject-5ee09.firebasestorage.app
